# 运行环境：dev / staging / prod
ENV=dev

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 大模型 API 密钥（必填）。从服务商开放平台获取，只显示一次，注意保存
LLM_API_KEY=

# 接口地址，需兼容 OpenAI Chat Completions 协议
# DeepSeek: https://api.deepseek.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名（deepseek-v4-flash 是遗留名，仍可用且同价）
LLM_MODEL=deepseek-flash

# 请求超时秒数，范围 1-300
REQUEST_TIMEOUT=30